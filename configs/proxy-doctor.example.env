# Generic example configuration.
# Copy to .env and adjust for your local proxy setup.

PD_PROVIDER=custom

# Agent workflow profile for built-in probes and learned compact thresholds.
# Common values: generic, codex, claude, custom.
PD_AGENT_PROFILE=generic
# PD_AGENT_NAME=my-local-agent

# These can also be inherited from HTTP_PROXY/http_proxy and ALL_PROXY/all_proxy.
PD_HTTP_PROXY=http://127.0.0.1:7890
PD_SOCKS_PROXY=socks5h://127.0.0.1:7891

# Optional explicit ports. If omitted, ports are parsed from proxy URLs.
# PD_HTTP_PORT=7890
# PD_SOCKS_PORT=7891

# Optional custom probe targets file.
# Format per line: label|url|allowed_status_codes
# PD_PROBE_TARGETS_FILE=/path/to/probes.txt

# Optional safe restart command. This is trusted local shell config.
# Repair remains dry-run unless the CLI is called with --allow-restart --apply.
# PD_RESTART_COMMAND='launchctl kickstart -k "gui/$(id -u)/com.example.proxy"'

# State defaults to XDG_STATE_HOME or ~/.local/state/proxy-stability-doctor.
# If neither default is writable, auto-created state falls back to TMPDIR.
# PD_STATE_DIR=/tmp/proxy-stability-doctor-state

# Compact threshold detector state. Leave unset unless you need custom paths.
# PD_COMPACT_OBSERVATION_LOG=/tmp/proxy-stability-doctor-state/compact-observations.log
# PD_COMPACT_STATE=/tmp/proxy-stability-doctor-state/compact-threshold.state
# PD_COMPACT_FAILURE_MARGIN_PERCENT=80
# PD_COMPACT_SUCCESS_MARGIN_PERCENT=90
# PD_COMPACT_SCAN_MAX_BYTES=1048576
# PD_COMPACT_SCAN_MAX_OBSERVATIONS=200
