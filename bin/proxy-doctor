#!/usr/bin/env bash
set -euo pipefail

PD_VERSION="0.1.0"
PD_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$PD_SOURCE" ]; do
  PD_SOURCE_DIR="$(cd -P "$(dirname "$PD_SOURCE")" && pwd)"
  PD_SOURCE_TARGET="$(readlink "$PD_SOURCE")"
  case "$PD_SOURCE_TARGET" in
    /*) PD_SOURCE="$PD_SOURCE_TARGET" ;;
    *) PD_SOURCE="$PD_SOURCE_DIR/$PD_SOURCE_TARGET" ;;
  esac
done
PD_ROOT_DIR="$(cd -P "$(dirname "$PD_SOURCE")/.." && pwd)"
PD_LIB_DIR="$PD_ROOT_DIR/lib/proxy_doctor"

usage() {
  cat <<'USAGE'
Usage:
  proxy-doctor [--config FILE] [--provider NAME] [--agent PROFILE] [--state-dir DIR] COMMAND [FLAGS]

Commands:
  doctor [--no-probes]
                      Run diagnostics.
  status              Print provider status and recent bounded events.
  compact status
                      Print learned compact threshold suggestions.
  compact observe --result success|failure [--tokens N] [--bytes N] [--source TEXT] [--reason TEXT]
                      Record a bounded compact observation.
  compact scan --log-file FILE
                      Scan a local agent log for compact observations.
  repair [--dry-run] [--allow-restart --apply] [--force] [--no-probes]
                      Diagnose and optionally repair.
  version             Print version.

Global options:
  --config FILE       Source a shell-style config file.
  --provider NAME     Adapter provider name. Defaults to custom.
  --agent PROFILE     Agent probe profile: generic, codex, claude-code, or custom.
  --state-dir DIR     State directory override.
  -h, --help          Show help.

Doctor flags:
  --no-probes         Skip outbound network probes and keep local diagnostics only.

Repair flags:
  --dry-run           Diagnose only. This is the default repair mode.
  --allow-restart     Permit a provider restart if preflight passes.
  --apply             Execute restart. Without this, repair is dry-run.
  --force             Attempt repair even if current health is good.
  --no-probes         Skip outbound network probes and require local health only.
USAGE
}

PD_CONFIG_FILE=""
COMMAND=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --config)
      [ "$#" -ge 2 ] || { echo "missing value for --config" >&2; exit 2; }
      PD_CONFIG_FILE="$2"
      shift 2
      ;;
    --provider)
      [ "$#" -ge 2 ] || { echo "missing value for --provider" >&2; exit 2; }
      PD_PROVIDER="$2"
      export PD_PROVIDER
      shift 2
      ;;
    --state-dir)
      [ "$#" -ge 2 ] || { echo "missing value for --state-dir" >&2; exit 2; }
      PD_STATE_DIR="$2"
      export PD_STATE_DIR
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --agent)
      [ "$#" -ge 2 ] || { echo "missing value for --agent" >&2; exit 2; }
      PD_AGENT_PROFILE="$2"
      export PD_AGENT_PROFILE
      shift 2
      ;;
    doctor|status|compact|repair|version)
      COMMAND="$1"
      shift
      break
      ;;
    *)
      echo "unknown option or command: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "$COMMAND" ]; then
  usage >&2
  exit 2
fi

if [ "$COMMAND" = "version" ]; then
  echo "$PD_VERSION"
  exit 0
fi

# shellcheck source=../lib/proxy_doctor/core.sh
. "$PD_LIB_DIR/core.sh"
# shellcheck source=../lib/proxy_doctor/config.sh
. "$PD_LIB_DIR/config.sh"
# shellcheck source=../lib/proxy_doctor/platform/darwin_launchctl.sh
. "$PD_LIB_DIR/platform/darwin_launchctl.sh"

pd_load_config_file "$PD_CONFIG_FILE"
pd_finalize_config
pd_load_adapter

case "$COMMAND" in
  doctor)
    # shellcheck source=../lib/proxy_doctor/actions/doctor.sh
    . "$PD_LIB_DIR/actions/doctor.sh"
    pd_action_doctor "$@"
    ;;
  status)
    # shellcheck source=../lib/proxy_doctor/actions/status.sh
    . "$PD_LIB_DIR/actions/status.sh"
    pd_action_status "$@"
    ;;
  compact)
    # shellcheck source=../lib/proxy_doctor/actions/compact.sh
    . "$PD_LIB_DIR/actions/compact.sh"
    pd_action_compact "$@"
    ;;
  repair)
    # shellcheck source=../lib/proxy_doctor/actions/repair.sh
    . "$PD_LIB_DIR/actions/repair.sh"
    pd_action_repair "$@"
    ;;
esac
